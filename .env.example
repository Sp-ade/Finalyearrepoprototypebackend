# Database Configuration
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/nilefinalyeardb

# Server Configuration
PORT=3000

# Seed User (for initial database setup)
SEED_EMAIL=test@nileuniversity.edu.ng
SEED_PASSWORD=password123
SEED_FIRST_NAME=Test
SEED_LAST_NAME=User
SEED_ROLE=student
SEED_STUDENT_ID=TEST001
SEED_DEPARTMENT=Computer Science

# Cloudinary Configuration
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Your App Name <your-email@gmail.com>

# JWT Secret
JWT_SECRET=supersecretkey

# Frontend URL
CLIENT_URL=http://localhost:3000