# Database Configuration
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/nilefinalyeardb
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=nilefinalyeardb

# Server Configuration
PORT=3000
JWT_SECRET=your_jwt_secret_key # Change this in production

# Seed User (for initial database setup)
SEED_EMAIL=test@nileuniversity.edu.ng
SEED_PASSWORD=password123
SEED_FIRST_NAME=Test
SEED_LAST_NAME=User
SEED_ROLE=student
SEED_STUDENT_ID=TEST001
SEED_DEPARTMENT=Computer Science

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

CLOUDINARY_PROJECT_FOLDER=local_projects_artifacts
CLOUDINARY_DOCS_FOLDER=local_documents
# Email Configuration (Defaulting to Office 365 settings)
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USER=your-email@nileuniversity.edu.ng
EMAIL_PASS=your-app-password
EMAIL_FROM="Nile University Repo" <your-email@nileuniversity.edu.ng>
BREVO_API_KEY= ENTER-BREVO-API-KEY-HERE
# Database Reset Control (Set to true to wipe DB and Cloudinary on next start)
RESET_DB=false

# Backend App URL (Used for verification links)
BACKEND_URL=https://your-service-name.onrender.com

ALLOW_DANGEROUS_SCRIPTS= true